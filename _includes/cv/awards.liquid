{% comment %}
  Unified awards entry renderer for both formats
  RenderCV: title, date, awarder, summary, url
  JSONResume: title, date, awarder, summary, url
{% endcomment %}

<div class="card-text font-weight-light">
  {% for entry in entries %}
    <div style="border-top: 1px solid #dee2e6; padding: 1rem 0;">
      <div class="container-fluid px-0">
        <div class="row align-items-start">
          <div class="col-3 col-sm-3 col-md-3 date-column d-flex flex-column align-items-end justify-content-start pr-3">
            {% capture award_date %}
              {% if entry.date %}{{ entry.date }}{% endif %}
            {% endcapture %}
            {% if award_date != '' %}
              <span class="badge font-weight-bold text-uppercase align-middle" style="min-width: 75px; background-color: var(--global-theme-color); color: white; display: block; text-align: center;">
                {{ award_date | split: '-' | first }}
              </span>
            {% endif %}
          </div>

          <div class="col-9 col-sm-9 col-md-9 mt-2 mt-md-0">
            {% if entry.url %}
              <h6 class="title font-weight-bold">
                <a href="{{ entry.url }}">{{ entry.title }}</a>
              </h6>
            {% elsif entry.title %}
              <h6 class="title font-weight-bold">{{ entry.title }}</h6>
            {% endif %}

            {% if entry.awarder %}
              <h6 style="font-size: 0.95rem">{{ entry.awarder }}</h6>
            {% endif %}

            {% if entry.summary %}
              <p style="font-size: 0.9rem;">{{ entry.summary | markdownify | remove: '<p>' | remove: '</p>' }}</p>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
